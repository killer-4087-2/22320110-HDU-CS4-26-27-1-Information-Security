# Minimal fix -- bumped Node.js base image
#
# The vulnerability is in the Node.js runtime itself (path.normalize), not in
# the application code, so the application source does not change at all.
# Node.js 8.5.0 introduced the defect and 8.6.0 fixed it, so 8.6.0 is the
# smallest version that removes the bug.

FROM node:8.6.0

LABEL maintainer="phithon <root@leavesongs.com>"

COPY package.json package-lock.json /usr/src/

RUN set -ex \
    && cd /usr/src \
    && npm install

WORKDIR /usr/src

CMD ["npm", "run", "start"]
